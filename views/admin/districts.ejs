<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Select District — TrueScale Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --ts-bg: #00121a;
            --ts-dark: #001e2b;
            --ts-surface: #042633;
            --ts-border: #0c3845;
            --ts-green: #00ed64;
            --ts-text: #f8fbfa;
            --ts-muted: #81989f;
            --ts-radius: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: var(--ts-bg);
            color: var(--ts-text);
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        header {
            background: var(--ts-dark);
            border-bottom: 1px solid var(--ts-border);
            padding: 18px clamp(16px, 5vw, 40px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            object-fit: cover;
        }

        .back-link {
            color: var(--ts-green);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            background: rgba(0, 237, 100, 0.08);
            border: 1px solid rgba(0, 237, 100, 0.2);
            transition: all 0.2s ease;
        }

        .back-link:hover {
            background: rgba(0, 237, 100, 0.18);
            transform: translateX(-2px);
        }

        .container {
            padding: clamp(24px, 4vw, 40px) clamp(16px, 5vw, 40px);
            max-width: 1100px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        h1 {
            font-size: clamp(22px, 3vw, 28px);
            font-weight: 800;
            margin-bottom: 6px;
            color: white;
        }

        .subtitle {
            color: var(--ts-muted);
            font-size: 14px;
            margin-bottom: 28px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: clamp(14px, 2vw, 20px);
        }

        .dist-card {
            background: var(--ts-dark);
            padding: clamp(20px, 2.5vw, 26px);
            border-radius: var(--ts-radius);
            border: 1px solid var(--ts-border);
            text-decoration: none;
            color: inherit;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
            min-height: 80px;
        }

        .dist-card:hover {
            border-color: var(--ts-green);
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 237, 100, 0.15);
        }

        .dist-card h2 {
            font-size: 17px;
            font-weight: 700;
            color: white;
        }

        .badge {
            background: rgba(0, 237, 100, 0.15);
            color: var(--ts-green);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 800;
            border: 1px solid rgba(0, 237, 100, 0.3);
            white-space: nowrap;
        }

        .empty-state {
            background: var(--ts-dark);
            padding: 60px 20px;
            text-align: center;
            border-radius: var(--ts-radius);
            border: 1.5px dashed var(--ts-border);
            color: var(--ts-muted);
        }
    </style>
</head>
<body>
    <header>
        <a href="/admin/dashboard" class="brand">
            <img src="/images/logo.jpeg" alt="TrueScale Logo" class="brand-icon">
            <span>TrueScale Admin</span>
        </a>
        <a href="/admin/assign-inspector" class="back-link">← All States</a>
    </header>

    <div class="container">
        <h1>Select District in <%= selectedState %> (Step 2 of 3)</h1>
        <p class="subtitle">Narrow down the jurisdiction to view and dispatch field inspections.</p>
        
        <div class="grid">
            <% if (districtData && districtData.length > 0) { %>
                <% districtData.forEach(function(district) { %>
                    <a href="/admin/assign-inspector/<%= encodeURIComponent(selectedState) %>/<%= encodeURIComponent(district._id) %>" class="dist-card">
                        <h2><%= district._id %></h2>
                        <span class="badge"><%= district.count %> Pending</span>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state" style="grid-column: 1 / -1;">
                    <div style="font-size: 32px; margin-bottom: 10px;">✓</div>
                    <h3 style="color: white; margin-bottom: 4px;">No Pending Requests in <%= selectedState %></h3>
                    <p>All verification applications in this state have been assigned.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>