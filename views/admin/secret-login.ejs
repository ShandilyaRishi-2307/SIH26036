<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>System Access — TrueScale Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --ts-dark: #000c12;
            --ts-dark-card: rgba(0, 26, 36, 0.75);
            --ts-green: #00ed64;
            --ts-green-dark: #008f3d;
            --ts-border: rgba(0, 237, 100, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            min-height: 100dvh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            position: relative;
            background-color: var(--ts-dark);
            padding: clamp(16px, 4vw, 32px);
            overflow: hidden;
        }

        /* Ambient Glow & Blurred Logo Background */
        body::before {
            content: "";
            position: absolute;
            inset: -20px;
            background-image:
                radial-gradient(circle at 50% 50%, rgba(0, 237, 100, 0.08), transparent 60%),
                linear-gradient(rgba(0, 12, 18, 0.85), rgba(0, 12, 18, 0.95)),
                url('/images/logo.jpeg');
            background-size: cover, cover, contain;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(12px);
            -webkit-filter: blur(12px);
            z-index: -1;
        }

        .login-box {
            background: var(--ts-dark-card);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: clamp(28px, 6vw, 44px);
            border-radius: 16px;
            width: 100%;
            max-width: 420px;
            border: 1px solid var(--ts-border);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 237, 100, 0.08);
            z-index: 1;
            position: relative;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #81989f;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
            transition: color 0.2s ease;
        }

        .back-link:hover {
            color: var(--ts-green);
        }

        .badge-lock {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(0, 237, 100, 0.12);
            border: 1px solid rgba(0, 237, 100, 0.3);
            color: var(--ts-green);
            border-radius: 20px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
            margin-bottom: 14px;
        }

        h2 {
            margin-bottom: 8px;
            font-size: clamp(20px, 3vw, 24px);
            font-weight: 800;
            color: white;
            letter-spacing: -0.02em;
        }

        p.subtitle {
            font-size: 13px;
            color: #81989f;
            margin-bottom: 26px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #b0c2c7;
            letter-spacing: 0.5px;
        }

        input {
            width: 100%;
            height: 48px;
            padding: 0 16px;
            background: rgba(0, 14, 20, 0.8);
            border: 1.5px solid #0c3845;
            border-radius: 10px;
            color: white;
            outline: none;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        input:focus {
            border-color: var(--ts-green);
            background: rgba(0, 14, 20, 1);
            box-shadow: 0 0 0 4px rgba(0, 237, 100, 0.15);
        }

        button {
            width: 100%;
            height: 50px;
            background: var(--ts-green);
            color: #001e2b;
            border: none;
            border-radius: 10px;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 0.5px;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(0, 237, 100, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        button:hover {
            background: #00d65a;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 237, 100, 0.45);
        }

        button:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>
    <div class="login-box">
        <a href="/" class="back-link">← Back to Home</a>
        <div class="badge-lock">🔒 RESTRICTED PORTAL</div>
        <h2>System Gateway</h2>
        <p class="subtitle">Enter administrative credentials to access the central management console.</p>

        <form action="/admin/secret-gateway" method="POST" autocomplete="off">
            <div class="form-group">
                <label for="admin-email">Administrator Email</label>
                <input type="email" id="admin-email" name="email" placeholder="admin@truescale.internal" autocomplete="off" required>
            </div>
            <div class="form-group">
                <label for="admin-password">Secure Passcode</label>
                <input type="password" id="admin-password" name="password" placeholder="••••••••••••" autocomplete="new-password" required>
            </div>
            <button type="submit">INITIALIZE SESSION →</button>
        </form>
    </div>
</body>
</html>