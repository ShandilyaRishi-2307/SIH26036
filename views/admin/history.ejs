<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>System History & Logs — TrueScale Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --ts-bg: #00121a;
            --ts-dark: #001e2b;
            --ts-surface: #042633;
            --ts-border: #0c3845;
            --ts-green: #00ed64;
            --ts-text: #f8fbfa;
            --ts-muted: #81989f;
            --ts-radius: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: var(--ts-bg);
            color: var(--ts-text);
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        header {
            background: var(--ts-dark);
            border-bottom: 1px solid var(--ts-border);
            padding: 18px clamp(16px, 5vw, 40px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            flex-wrap: wrap;
            gap: 12px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            object-fit: cover;
        }

        .badge-admin {
            background: var(--ts-green);
            color: var(--ts-dark);
            font-size: 10px;
            font-weight: 800;
            padding: 3px 7px;
            border-radius: 4px;
            letter-spacing: 0.5px;
        }

        .nav-links {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .back-link {
            color: var(--ts-green);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            background: rgba(0, 237, 100, 0.08);
            border: 1px solid rgba(0, 237, 100, 0.2);
            transition: all 0.2s ease;
        }

        .back-link:hover {
            background: rgba(0, 237, 100, 0.18);
            transform: translateX(-2px);
        }

        .logout-link {
            color: #ff6b6b;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid rgba(255, 107, 107, 0.2);
            transition: all 0.2s ease;
        }

        .logout-link:hover {
            background: rgba(255, 107, 107, 0.12);
        }

        .content {
            flex: 1;
            padding: clamp(24px, 4vw, 50px) clamp(16px, 5vw, 50px);
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }

        .page-header {
            margin-bottom: clamp(24px, 3.5vh, 36px);
            border-bottom: 1px solid var(--ts-border);
            padding-bottom: 20px;
        }

        h1 {
            font-size: clamp(24px, 3.5vw, 32px);
            font-weight: 800;
            margin-bottom: 4px;
            letter-spacing: -0.02em;
        }

        p.subtitle {
            color: var(--ts-muted);
            font-size: 14.5px;
        }

        .section-title {
            font-size: 19px;
            font-weight: 800;
            margin: 36px 0 16px 0;
            display: flex;
            align-items: center;
            gap: 8px;
            color: white;
        }

        /* Certificate Table */
        .table-container {
            background: var(--ts-dark);
            border: 1px solid var(--ts-border);
            border-radius: var(--ts-radius);
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            min-width: 720px;
        }

        th {
            background: var(--ts-surface);
            color: var(--ts-muted);
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--ts-border);
            font-weight: 800;
            white-space: nowrap;
        }

        td {
            padding: 16px 18px;
            border-bottom: 1px solid var(--ts-border);
            font-size: 13.5px;
            color: var(--ts-text);
            vertical-align: middle;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(4, 38, 51, 0.6);
        }

        .cert-id {
            font-family: monospace;
            color: var(--ts-green);
            font-weight: 700;
            font-size: 14px;
            background: rgba(0, 237, 100, 0.1);
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid rgba(0, 237, 100, 0.2);
            display: inline-block;
        }

        .owner-name {
            font-weight: 700;
            color: #ffffff;
            display: block;
            margin-bottom: 2px;
        }

        .inst-type {
            color: var(--ts-muted);
            font-size: 12.5px;
        }

        .status-badge {
            display: inline-block;
            background: rgba(0, 237, 100, 0.15);
            color: var(--ts-green);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 800;
            border: 1px solid rgba(0, 237, 100, 0.3);
            white-space: nowrap;
        }

        /* Activity Feed */
        .log-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .log-item {
            background: var(--ts-dark);
            padding: 16px 20px;
            border: 1px solid var(--ts-border);
            border-radius: 10px;
            display: flex;
            gap: 16px;
            align-items: center;
            transition: border-color 0.2s ease;
        }

        .log-item:hover {
            border-color: rgba(0, 237, 100, 0.3);
        }

        .log-time {
            color: var(--ts-muted);
            font-size: 12.5px;
            min-width: 170px;
            font-weight: 600;
        }

        .log-tag {
            background: var(--ts-surface);
            color: #38bdf8;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 800;
            border: 1px solid var(--ts-border);
            min-width: 160px;
            text-align: center;
            white-space: nowrap;
        }

        .log-tag.onboard {
            color: #fbbf24;
            border-color: rgba(251, 191, 36, 0.3);
            background: rgba(251, 191, 36, 0.1);
        }

        .log-tag.assigned {
            color: #38bdf8;
            border-color: rgba(56, 189, 248, 0.3);
            background: rgba(56, 189, 248, 0.1);
        }

        .log-tag.resched-req {
            color: #ff6b6b;
            background: rgba(255, 107, 107, 0.1);
            border-color: rgba(255, 107, 107, 0.3);
        }

        .log-tag.resched-done {
            color: #a78bfa;
            background: rgba(167, 139, 250, 0.1);
            border-color: rgba(167, 139, 250, 0.3);
        }

        .log-desc {
            color: var(--ts-text);
            font-size: 14px;
            flex: 1;
            line-height: 1.45;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--ts-muted);
        }

        .empty-state h3 {
            color: white;
            font-size: 18px;
            margin-bottom: 6px;
        }

        @media (max-width: 800px) {
            .log-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .log-time {
                min-width: auto;
            }

            .log-tag {
                min-width: auto;
            }
        }
    </style>
</head>
<body>

    <header>
        <a href="/admin/dashboard" class="brand">
            <img src="/images/logo.jpeg" alt="TrueScale Logo" class="brand-icon">
            <span>TrueScale</span>
            <span class="badge-admin">SYS ADMIN</span>
        </a>
        <div class="nav-links">
            <a href="/admin/dashboard" class="back-link">← Command Center</a>
            <a href="/admin/logout" class="logout-link">Log Out</a>
        </div>
    </header>

    <main class="content">
        <div class="page-header">
            <h1>System History & Logs</h1>
            <p class="subtitle">Complete chronological ledger of all administrative actions, audit records, and issued digital verification certificates.</p>
        </div>

        <!-- Section 1: Certificate Ledger -->
        <h2 class="section-title">📄 Official Certificate Ledger</h2>
        <div class="table-container">
            <div class="table-responsive">
                <% if (history && history.length > 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Date Issued</th>
                                <th>Certificate No.</th>
                                <th>Entity / Owner</th>
                                <th>Instrument Details</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% history.forEach(function(cert) { %>
                                <tr>
                                    <td style="color: var(--ts-muted);"><%= new Date(cert.issueDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                    <td><a href="/verify/<%= cert.certificateNumber %>" target="_blank" class="cert-id" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="View & Verify Certificate"><%= cert.certificateNumber %> <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 10px; opacity: 0.7;"></i></a></td>
                                    <td><span class="owner-name"><%= cert.instrument.ownerName %></span></td>
                                    <td>
                                        <span style="display: block; font-weight: 700; margin-bottom: 2px; font-family: monospace;"><%= cert.instrument.instrumentId %></span>
                                        <span class="inst-type"><%= cert.instrument.type || cert.instrument.instrumentName %></span>
                                    </td>
                                    <td><span class="status-badge">✓ ISSUED</span></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state">
                        <div style="font-size: 32px; margin-bottom: 10px;">📄</div>
                        <h3>No Certificates Issued</h3>
                        <p>When you approve field reports, the generated digital certificates will permanently log here.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Section 2: Operational Audit Log -->
        <h2 class="section-title" style="margin-top: 50px;">⚙️ Operational Audit Log</h2>
        <div class="log-grid">
            <% if (adminLogs && adminLogs.length > 0) { %>
                <% adminLogs.forEach(function(log) { 
                    let tagClass = '';
                    if (log.actionType === 'Inspector Onboarded') tagClass = 'onboard';
                    else if (log.actionType === 'Task Assigned') tagClass = 'assigned';
                    else if (log.actionType === 'Reschedule Requested') tagClass = 'resched-req';
                    else if (log.actionType === 'Task Rescheduled') tagClass = 'resched-done';
                %>
                    <div class="log-item">
                        <div class="log-time">
                            <%= new Date(log.timestamp).toLocaleDateString('en-GB') %> • 
                            <%= new Date(log.timestamp).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                        </div>
                        
                        <div class="log-tag <%= tagClass %>">
                            <%= log.actionType %>
                        </div>
                        
                        <div class="log-desc">
                            <%= log.description %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="table-container empty-state">
                    <div style="font-size: 32px; margin-bottom: 10px;">⚙️</div>
                    <h3>No Administrative Actions</h3>
                    <p>Onboarding inspectors, dispatching tasks, and handling reschedules will automatically generate audit logs here.</p>
                </div>
            <% } %>
        </div>

    </main>
</body>
</html>