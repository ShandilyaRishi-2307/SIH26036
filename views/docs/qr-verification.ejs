<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Instant QR Verification — TrueScale Docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --ts-dark: #001e2b;
            --ts-green: #00ed64;
            --ts-green-dark: #00684a;
            --ts-green-light: #e8fff1;
            --ts-gray-50: #f8fafc;
            --ts-gray-100: #f1f5f9;
            --ts-gray-200: #e2e8f0;
            --ts-gray-600: #475569;
            --ts-radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--ts-gray-50);
            color: var(--ts-dark);
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        /* Top Header */
        header {
            background: white;
            border-bottom: 1px solid var(--ts-gray-200);
            padding: 0 clamp(16px, 5vw, 48px);
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--ts-dark);
            font-size: 20px;
            font-weight: 800;
        }

        .logo-img {
            width: 38px;
            height: 38px;
            border-radius: 8px;
            object-fit: cover;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        nav a {
            text-decoration: none;
            color: var(--ts-gray-600);
            font-size: 14px;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        nav a:hover, nav a.active {
            color: var(--ts-dark);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-nav {
            padding: 9px 16px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-outline {
            background: white;
            color: var(--ts-dark);
            border: 1px solid var(--ts-gray-200);
        }

        .btn-outline:hover {
            background: var(--ts-gray-100);
        }

        .btn-primary {
            background: var(--ts-dark);
            color: white;
            border: 1px solid var(--ts-dark);
        }

        .btn-primary:hover {
            background: #003043;
        }

        /* Container */
        .main {
            width: min(94%, 1100px);
            margin: clamp(20px, 4vw, 40px) auto;
            background: white;
            border: 1px solid var(--ts-gray-200);
            border-radius: var(--ts-radius);
            padding: clamp(30px, 5vw, 60px) clamp(18px, 4vw, 44px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        }

        .main > h1 {
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 900;
            letter-spacing: -0.02em;
            color: var(--ts-dark);
            margin-bottom: 12px;
            text-align: center;
        }

        .subtitle {
            font-size: clamp(15px, 2vw, 18px);
            color: var(--ts-gray-600);
            line-height: 1.55;
            max-width: 650px;
            margin: 0 auto clamp(32px, 5vw, 48px);
            text-align: center;
        }

        /* Steps */
        .steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: clamp(36px, 5vw, 60px);
        }

        .step {
            background: var(--ts-gray-50);
            border: 1px solid var(--ts-gray-200);
            border-radius: var(--ts-radius);
            padding: 24px 18px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: all 0.25s ease;
        }

        .step:hover {
            transform: translateY(-4px);
            border-color: var(--ts-green);
            box-shadow: 0 8px 24px rgba(0, 237, 100, 0.12);
        }

        .circle {
            width: 72px;
            height: 72px;
            border: 1.5px solid #c7f3d6;
            border-radius: 50%;
            background: var(--ts-green-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ts-green-dark);
            font-size: 26px;
            margin-bottom: 14px;
        }

        .step span.step-tag {
            display: inline-flex;
            background: var(--ts-dark);
            color: var(--ts-green);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .step h3 {
            font-size: 16px;
            font-weight: 800;
            color: var(--ts-dark);
            margin-bottom: 8px;
        }

        .step p {
            font-size: 13px;
            color: var(--ts-gray-600);
            line-height: 1.5;
        }

        /* Verification Card Simulation */
        .verification {
            background: var(--ts-gray-50);
            border: 1px solid var(--ts-gray-200);
            border-radius: var(--ts-radius);
            padding: clamp(24px, 4vw, 40px);
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: clamp(24px, 4vw, 44px);
            align-items: center;
        }

        .phone {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .phone h4 {
            font-size: 14.5px;
            font-weight: 800;
            margin-bottom: 14px;
            color: var(--ts-dark);
        }

        .phone-screen {
            width: 200px;
            height: 240px;
            border: 8px solid var(--ts-dark);
            border-radius: 24px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .scan-line {
            position: absolute;
            width: 100%;
            height: 3px;
            background: var(--ts-green);
            box-shadow: 0 0 8px var(--ts-green);
            z-index: 5;
            animation: scanAnim 2.4s ease-in-out infinite;
        }

        @keyframes scanAnim {
            0% { top: 15%; opacity: 0; }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% { top: 85%; opacity: 0; }
        }

        .verified {
            margin-top: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            background: #d1fae5;
            color: #047857;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 800;
        }

        .result {
            background: white;
            border: 1px solid var(--ts-gray-200);
            border-radius: var(--ts-radius);
            padding: clamp(20px, 3vw, 30px);
        }

        .result h2 {
            color: var(--ts-dark);
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .result-row {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--ts-gray-100);
            font-size: 13.5px;
            gap: 10px;
        }

        .result-row:last-child {
            border-bottom: none;
        }

        .result-row i {
            color: var(--ts-green-dark);
            width: 18px;
            text-align: center;
        }

        .result-row b {
            min-width: 120px;
            color: var(--ts-gray-600);
            font-weight: 600;
        }

        .result-row p {
            color: var(--ts-dark);
            font-weight: 700;
        }

        .badge-valid {
            background: #d1fae5;
            color: #047857;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
        }

        /* Bottom Feature Banner */
        .bottom {
            margin-top: 36px;
            padding: 24px;
            background: white;
            border-radius: var(--ts-radius);
            border: 1px solid var(--ts-gray-200);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            text-align: left;
        }

        .bottom-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--ts-green);
            color: var(--ts-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 900;
            flex-shrink: 0;
        }

        .bottom h2 {
            font-size: 17px;
            font-weight: 800;
            color: var(--ts-dark);
            margin-bottom: 2px;
        }

        .bottom p {
            font-size: 13.5px;
            color: var(--ts-gray-600);
        }

        /* Responsive Breakpoints */
        @media (max-width: 850px) {
            nav {
                display: none;
            }

            .verification {
                grid-template-columns: 1fr;
            }

            .result-row {
                flex-wrap: wrap;
            }

            .result-row b {
                min-width: 90px;
            }
        }

        @media (max-width: 600px) {
            header {
                padding: 0 16px;
            }

            .bottom {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- Top Header -->
    <header>
        <a href="/" class="logo">
            <img src="/images/logo.jpeg" alt="TrueScale Logo" class="logo-img">
            <span>TrueScale</span>
        </a>
        <nav>
            <a href="/">Home</a>
            <a href="/docs/digital-certificate">Certificate Flow</a>
            <a href="/docs/digital-verification">Digital Verification</a>
            <a href="/docs/inspector-assignment">Inspector Dispatch</a>
            <a href="/docs/qr-verification" class="active">QR Verification</a>
        </nav>
        <div class="header-actions">
            <a href="/login" class="btn-nav btn-outline">Log In</a>
            <a href="/signup" class="btn-nav btn-primary">Get Started</a>
        </div>
    </header>

    <div class="main">
        <h1>Instant QR Certificate Verification</h1>
        <p class="subtitle">Consumers, merchants, and regulatory officers can scan the dynamic QR code on any certificate or instrument sticker to authenticate calibration records in real time.</p>

        <div class="steps">
            <div class="step">
                <div class="circle">
                    <i class="fa-solid fa-qrcode"></i>
                </div>
                <span class="step-tag">Step 01</span>
                <h3>Scan QR Code</h3>
                <p>Scan with any standard smartphone camera or QR scanner app.</p>
            </div>

            <div class="step">
                <div class="circle">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <span class="step-tag">Step 02</span>
                <h3>Cryptographic Check</h3>
                <p>System verifies signature authenticity against the official central registry.</p>
            </div>

            <div class="step">
                <div class="circle">
                    <i class="fa-solid fa-square-poll-vertical"></i>
                </div>
                <span class="step-tag">Step 03</span>
                <h3>Instant Metadata</h3>
                <p>Verify owner name, calibration dates, tolerance errors, and expiry status.</p>
            </div>
        </div>

        <div class="verification">
            <div class="phone">
                <h4>Live QR Simulation</h4>
                <div class="phone-screen">
                    <div class="scan-line"></div>
                    <div id="mainQR"></div>
                </div>
                <div class="verified">
                    <span>✓</span> Verified Authenticity
                </div>
            </div>

            <div class="result">
                <h2><i class="fa-solid fa-certificate"></i> Verified Record Output</h2>

                <div class="result-row">
                    <i class="fa-regular fa-id-card"></i>
                    <b>Certificate No.</b>
                    <p style="font-family: monospace;">CLM/2026/001234</p>
                </div>

                <div class="result-row">
                    <i class="fa-regular fa-user"></i>
                    <b>Owner Entity</b>
                    <p>M/s. ABC Weighing Machine Co.</p>
                </div>

                <div class="result-row">
                    <i class="fa-solid fa-user-tie"></i>
                    <b>Issued By</b>
                    <p>Controller of Legal Metrology</p>
                </div>

                <div class="result-row">
                    <i class="fa-regular fa-calendar"></i>
                    <b>Issue Date</b>
                    <p>15 May 2026</p>
                </div>

                <div class="result-row">
                    <i class="fa-regular fa-calendar-check"></i>
                    <b>Expiry Date</b>
                    <p>15 May 2027</p>
                </div>

                <div class="result-row">
                    <i class="fa-regular fa-circle-check"></i>
                    <b>Status</b>
                    <p><span class="badge-valid">✓ Legally Valid</span></p>
                </div>
            </div>
        </div>

        <div class="bottom">
            <div class="bottom-icon">✓</div>
            <div>
                <h2>Scan. Verify. Trust.</h2>
                <p>Eliminating fraud and counterfeit weighing verification stamps across all commercial establishments.</p>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const qrContainer = document.getElementById("mainQR");
            if (qrContainer && typeof QRCode !== 'undefined') {
                const qrData = JSON.stringify({
                    cert: "CLM/2026/001234",
                    owner: "M/s. ABC Weighing Machine Co.",
                    issued: "15 May 2026",
                    validUntil: "15 May 2027",
                    status: "Valid"
                });

                new QRCode(qrContainer, {
                    text: qrData,
                    width: 140,
                    height: 140,
                    colorDark: "#001e2b",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    </script>
</body>
</html>