<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Certificate Verification Failed — TrueScale</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --ts-dark: #001e2b;
            --ts-green: #00ed64;
            --ts-green-dark: #00684a;
            --ts-red: #ef4444;
            --ts-red-light: #fef2f2;
            --ts-gray-50: #f8fafc;
            --ts-gray-200: #e2e8f0;
            --ts-gray-600: #475569;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--ts-gray-50);
            color: var(--ts-dark);
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .card {
            background: white;
            max-width: 540px;
            width: 100%;
            border-radius: 20px;
            padding: clamp(28px, 6vw, 44px);
            box-shadow: 0 16px 40px rgba(0, 30, 43, 0.08);
            border: 1px solid var(--ts-gray-200);
            text-align: center;
        }

        .icon-circle {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: var(--ts-red-light);
            color: var(--ts-red);
            font-size: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            border: 2px solid rgba(239, 68, 68, 0.2);
        }

        h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--ts-dark);
            margin-bottom: 12px;
            letter-spacing: -0.02em;
        }

        p {
            font-size: 15px;
            color: var(--ts-gray-600);
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .searched-cert {
            background: #f1f5f9;
            padding: 10px 16px;
            border-radius: 8px;
            font-family: ui-monospace, monospace;
            font-size: 15px;
            font-weight: 700;
            color: var(--ts-dark);
            display: inline-block;
            margin-bottom: 24px;
            border: 1px dashed #cbd5e1;
        }

        .search-form {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
        }

        .search-input {
            flex: 1;
            padding: 12px 16px;
            border: 1.5px solid var(--ts-gray-200);
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        .search-input:focus {
            border-color: var(--ts-green-dark);
        }

        .search-btn {
            background: var(--ts-dark);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .search-btn:hover {
            background: #003348;
        }

        .actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-link {
            padding: 11px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--ts-green);
            color: var(--ts-dark);
        }

        .btn-primary:hover {
            background: #00d957;
        }

        .btn-outline {
            background: white;
            border: 1.5px solid var(--ts-gray-200);
            color: var(--ts-dark);
        }

        .btn-outline:hover {
            border-color: var(--ts-dark);
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon-circle">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1>Certificate Not Found</h1>
        <p>The certificate record you requested does not exist in the TrueScale central verification registry or has not been issued yet.</p>

        <% if (typeof certificateNumber !== 'undefined' && certificateNumber) { %>
            <div class="searched-cert">
                Query: <strong><%= certificateNumber %></strong>
            </div>
        <% } %>

        <form class="search-form" action="/verify" method="GET">
            <input type="text" name="cert" class="search-input" placeholder="Enter Certificate No. (e.g. TS-XXXXX)" required>
            <button type="submit" class="search-btn">Verify</button>
        </form>

        <div class="actions">
            <a href="/" class="btn-link btn-primary"><i class="fa-solid fa-house"></i> Home</a>
            <a href="/docs/qr-verification" class="btn-link btn-outline"><i class="fa-solid fa-qrcode"></i> Verification Guide</a>
        </div>
    </div>
</body>
</html>
