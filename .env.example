# TrueScale Environment Variables Template
PORT=3000
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/truescale"

# Firebase Web App Client Configuration
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
FIREBASE_APP_ID="your-app-id"

# Firebase Admin SDK (Option A: Full Service Account JSON as string for production/cloud hosting)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Firebase Admin SDK (Option B: Individual parameters)
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Secret Credentials (Optional custom admin override)
# ADMIN_EMAIL="rajnanda4ever@gmail.com"
# ADMIN_PASSWORD="your-admin-password"
